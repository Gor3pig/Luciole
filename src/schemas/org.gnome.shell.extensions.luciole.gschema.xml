<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="luciole">
  <schema id="org.gnome.shell.extensions.luciole" path="/org/gnome/shell/extensions/luciole/">

    <key name="toggle-shortcut" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;space"]</default>
      <summary>Shortcut that opens the launcher</summary>
    </key>

    <key name="providers-enabled" type="as">
      <default>["apps", "files"]</default>
      <summary>Enabled result providers</summary>
    </key>

    <key name="providers-order" type="as">
      <default>["apps", "files"]</default>
      <summary>Display order of result providers</summary>
    </key>

    <key name="max-results" type="i">
      <range min="3" max="30"/>
      <default>6</default>
      <summary>Maximum number of results per provider</summary>
    </key>

    <key name="excluded-folders" type="as">
      <default>["node_modules"]</default>
      <summary>Folders excluded from file results</summary>
    </key>

    <key name="excluded-types" type="as">
      <default>[]</default>
      <summary>File types excluded from file results</summary>
    </key>

    <key name="history-generation" type="i">
      <default>0</default>
      <summary>Incremented by the preferences to ask for the usage history to be erased</summary>
    </key>

    <key name="debug-timings" type="b">
      <default>false</default>
      <summary>Log debug messages and timings</summary>
    </key>

  </schema>
</schemalist>
