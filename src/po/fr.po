msgstr "Apparence"

#: src/prefs.js src/ui/results-view.js
msgid "Results"
msgstr "Résultats"

#: src/prefs.js
msgid "Results per source"
msgstr "Résultats par source"

#: src/prefs.js
msgid "How many results each source shows at most"
msgstr "Nombre maximal de résultats affichés par source"

#: src/prefs.js
msgid "History"
msgstr "Historique"

#: src/prefs.js
msgid ""
"Luciole remembers which results you open and the searches that led to them, "
"only on this computer."
msgstr ""
"Luciole retient les résultats que vous ouvrez et les recherches qui y ont "
"mené, uniquement sur cet ordinateur."

#: src/prefs.js
msgid "Remember Searches"
msgstr "Retenir les recherches"

#: src/prefs.js
msgid ""
"Lets the up arrow bring back a previous search. Turning this off erases them"
msgstr ""
"Permet de rappeler une recherche avec la flèche haut. Désactiver efface les "
"recherches retenues"

#: src/prefs.js
msgid "Clear History"
msgstr "Effacer l’historique"

#: src/prefs.js
msgid "Advanced"
msgstr "Avancé"

#: src/prefs.js
msgid "Log Timings"
msgstr "Journaliser les durées"

#: src/prefs.js
msgid "Writes debug messages to the system journal"
msgstr "Écrit des messages de débogage dans le journal système"

#: src/prefs.js
msgid "Open Luciole"
msgstr "Ouvrir Luciole"

#: src/prefs.js
msgid "Disabled"
msgstr "Désactivé"

#. Translators: %s is the name of another GNOME shortcut
#: src/prefs.js
#, javascript-format
msgid "Already used by the GNOME shortcut “%s”"
msgstr "Déjà utilisé par le raccourci GNOME « %s »"

#: src/prefs.js
msgid "Change…"
msgstr "Modifier…"

#: src/prefs.js
msgid "Set Shortcut"
msgstr "Définir le raccourci"

#: src/prefs.js
msgid ""
"Press the new shortcut. Escape cancels, Backspace disables the shortcut."
msgstr ""
"Appuyez sur le nouveau raccourci. Échap annule, Retour arrière désactive le "
"raccourci."

#: src/prefs.js
msgid "Cancel"
msgstr "Annuler"

#: src/prefs.js
msgid "Sources"
msgstr "Sources"

#: src/prefs.js
msgid "What Luciole searches. Applications are always listed before files."
msgstr ""
"Ce que Luciole recherche. Les applications sont toujours listées avant les "
"fichiers."

#: src/prefs.js
msgid "Excluded Folders"
msgstr "Dossiers exclus"

#: src/prefs.js
msgid ""
"Files in these folders are never shown. A name such as “node_modules” "
"excludes every folder with that name; hidden files are always left out."
msgstr ""
"Les fichiers de ces dossiers ne sont jamais affichés. Un nom comme "
"« node_modules » exclut tous les dossiers portant ce nom ; les fichiers "
"cachés sont toujours ignorés."

#: src/prefs.js
msgid "Add Folder…"
msgstr "Ajouter un dossier…"

#: src/prefs.js
msgid "Excluded File Types"
msgstr "Types de fichiers exclus"

#: src/prefs.js
msgid ""
"Files with these extensions are never shown, for example “tmp” or “.log”."
msgstr ""
"Les fichiers ayant ces extensions ne sont jamais affichés, par exemple "
"« tmp » ou « .log »."

#: src/prefs.js
msgid "Add Type"
msgstr "Ajouter un type"

#: src/prefs.js
msgid "Remove"
msgstr "Retirer"

#: src/prefs.js
msgid "Choose a Folder to Exclude"
msgstr "Choisir un dossier à exclure"

