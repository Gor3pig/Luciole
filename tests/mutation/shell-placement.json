{
 "description": "Mutants for where the launcher appears; only a shell with two monitors can show them.",
 "slow": true,
 "timeout": 300,
 "command": [
  "sh",
  "tests/shell/placement.sh"
 ],
 "mutants": [
  {
   "file": "src/shell/compat.js",
   "label": "the pointer monitor is ignored",
   "old": "        pointerIndex: global.display.get_current_monitor(),",
   "new": "        pointerIndex: undefined,"
  },
  {
   "file": "src/ui/launcher.js",
   "label": "the window is not moved to the chosen monitor",
   "old": "        this.#overlay.set_position(monitor.x, monitor.y);",
   "new": "        this.#overlay.set_position(0, 0);"
  },
  {
   "file": "src/ui/launcher.js",
   "label": "the field is not placed from the layout",
   "old": "        this.#overlay.set_style(`padding-top: ${top}px;`);",
   "new": "        this.#overlay.set_style('padding-top: 100px;');"
  },
  {
   "file": "src/ui/launcher.js",
   "label": "the backdrop setting is not applied",
   "old": "this.#overlay.set_style_class_name(extra ? `luciole-overlay ${extra}` : 'luciole-overlay');",
   "new": "this.#overlay.set_style_class_name('luciole-overlay');"
  },
  {
   "file": "src/extension.js",
   "label": "the backdrop setting is not read",
   "old": "getBackdrop: () => settings.get_string('backdrop'),",
   "new": "getBackdrop: () => 'none',"
  },
  {
   "file": "src/shell/compat.js",
   "label": "the window is stacked above the shell's dialogs",
   "old": "Main.uiGroup.insert_child_below(actor, Main.layoutManager.modalDialogGroup);",
   "new": "Main.uiGroup.add_child(actor);"
  },
  {
   "file": "src/shell/compat.js",
   "label": "the window is stacked under the top bar",
   "old": "Main.uiGroup.insert_child_below(actor, Main.layoutManager.modalDialogGroup);",
   "new": "Main.uiGroup.insert_child_below(actor, Main.layoutManager.panelBox);"
  }
 ]
}
